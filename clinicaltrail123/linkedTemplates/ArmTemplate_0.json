{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "clinicaltrail123"
		},
		"Linked_service_Adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Linked_service_Adls'"
		},
		"Linked_service_Adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsclinical.dfs.core.windows.net/"
		},
		"Linked_service_Keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://ClinicaltrialKeyvalult.vault.azure.net/"
		},
		"Linked_serv_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1030-134951-7pn5yxsr"
		},
		"Linked_service_Azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "clinicaltraildatabase.database.windows.net"
		},
		"Linked_service_Azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Clnical_trail"
		},
		"Linked_service_Azuresql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "prajwalprajs"
		},
		"Linked_service_postgre_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-gentle-bonus-a1ve4ci5-pooler.ap-southeast-1.aws.neon.tech"
		},
		"Linked_service_postgre_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"Linked_service_postgre_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Linked_service_Adls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('Linked_service_Adls_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('Linked_service_Adls_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Linked_service_Keyvault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('Linked_service_Keyvault_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Ds_Adls')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Linked_service_Adls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"container": {
						"type": "string"
					},
					"files": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": {
							"value": "@dataset().files",
							"type": "Expression"
						},
						"fileSystem": {
							"value": "@dataset().container",
							"type": "Expression"
						}
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_Adls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Linked_serv_databricks')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405618894432925.5.azuredatabricks.net",
					"accessToken": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "Linked_service_Keyvault",
							"type": "LinkedServiceReference"
						},
						"secretName": "databrickspswwrd"
					},
					"existingClusterId": "[parameters('Linked_serv_databricks_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_Keyvault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Linked_service_Azuresql')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('Linked_service_Azuresql_properties_typeProperties_server')]",
					"database": "[parameters('Linked_service_Azuresql_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('Linked_service_Azuresql_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "Linked_service_Keyvault",
							"type": "LinkedServiceReference"
						},
						"secretName": "azuresqlpswrd"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_Keyvault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Linked_service_postgre')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('Linked_service_postgre_properties_typeProperties_server')]",
					"port": 5432,
					"database": "[parameters('Linked_service_postgre_properties_typeProperties_database')]",
					"username": "[parameters('Linked_service_postgre_properties_typeProperties_username')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "Linked_service_Keyvault",
							"type": "LinkedServiceReference"
						},
						"secretName": "PostgrePsswrd"
					},
					"sslMode": 2,
					"authenticationType": "Basic"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_Keyvault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Ds_Azuresql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Linked_service_Azuresql",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_Azuresql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Ds_postgresql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Linked_service_postgre",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_postgre')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Test')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "Select * FROM PUBLIC.hospitals",
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "Ds_postgresql",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "Ds_Adls",
								"type": "DatasetReference",
								"parameters": {
									"container": "landing",
									"files": "test"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Ds_postgresql')]",
				"[concat(variables('factoryId'), '/datasets/Ds_Adls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/source_to_silver_inner_pipln')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read azrsql ctrl_tablecnfg colums",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select * from ctrl.table_config Where table_id = '@{pipeline().parameters.table_id}' ",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "Ds_Azuresql",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Start_Time",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "Start_time",
							"value": {
								"value": "@formatDateTime(\n    convertFromUtc(utcNow(),'India Standard Time'),\n    'yyyy-MM-dd_HH:mm:ss'\n)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "source_to_landing ingetion",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Check the load type full or merge",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": {
									"value": "select * from PUBLIC.@{activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.source_table_name}\n@{\n    if(equals(activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.load_type,'FULL')\n        ,'',\n    concat( \n        'where ',activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.watermark_column ,' > ','''',variables('watermark_value'), ''''\n        )\n    )\n}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "Ds_postgresql",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "Ds_Adls",
								"type": "DatasetReference",
								"parameters": {
									"container": "landing",
									"files": {
										"value": "@concat(    \nactivity('Read azrsql ctrl_tablecnfg colums').output.firstRow.source_system,\n'/',\nactivity('Read azrsql ctrl_tablecnfg colums').output.firstRow.source_table_name,\n'/',\nvariables('Start_time')\n)",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "landing to bronze",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "source_to_landing ingetion",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/new_clinical_trail/Clinical_trail_databricks/landing_to_bronze",
							"baseParameters": {
								"source_system": {
									"value": "@activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.source_system",
									"type": "Expression"
								},
								"table_name": {
									"value": "@activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.bronze_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('Start_time')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "Linked_serv_databricks",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Bronze to silver",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "landing to bronze",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/new_clinical_trail/Clinical_trail_databricks/bronze_to_silver",
							"baseParameters": {
								"table_name": {
									"value": "@activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.silver_table_name",
									"type": "Expression"
								},
								"landing_timestamp": {
									"value": "@variables('Start_time')",
									"type": "Expression"
								},
								"merge_keys": {
									"value": "@coalesce(activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.merge_keys,'') ",
									"type": "Expression"
								},
								"load_type": {
									"value": "@activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.load_type",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "Linked_serv_databricks",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Success status",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Bronze to silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "Linked_service_Azuresql",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "UPDATE ctrl.audit_log\nset STATUS = 'SUCCESS' , end_time = DATEADD(MINUTE, 330, SYSUTCDATETIME()),records_written=@{activity('Bronze to silver').output.runOutput}\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id = @{pipeline().parameters.table_id}\n",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Check the load type full or merge",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Read azrsql ctrl_tablecnfg colums",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Start_Time",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.load_type,'FULL'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Read watermark value",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "select watermark_value \nfrom ctrl.watermark \nwhere table_id = @{pipeline().parameters.table_id}\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "Ds_Azuresql",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "Store watermark value",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Read watermark value",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "watermark_value",
										"value": {
											"value": "@activity('Read watermark value').output.firstRow.watermark_value",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "Checking load type and update watermark",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Success status",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('Read azrsql ctrl_tablecnfg colums').output.firstRow.load_type,'FULL'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "update watermark",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "Linked_service_Azuresql",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update ctrl.watermark\nset watermark_value= DATEADD(MINUTE, 330, SYSUTCDATETIME()) \nwhere table_id = @{pipeline().parameters.table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_id": {
						"type": "string",
						"defaultValue": "1"
					},
					"adf_run_id": {
						"type": "string",
						"defaultValue": "a1"
					}
				},
				"variables": {
					"Start_time": {
						"type": "String"
					},
					"watermark_value": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Ds_Azuresql')]",
				"[concat(variables('factoryId'), '/datasets/Ds_postgresql')]",
				"[concat(variables('factoryId'), '/datasets/Ds_Adls')]",
				"[concat(variables('factoryId'), '/linkedServices/Linked_serv_databricks')]",
				"[concat(variables('factoryId'), '/linkedServices/Linked_service_Azuresql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Source_to_Silver_Main')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Ingest all table from lookup",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Read_azrsql_ctrl_tableconfig tableid",

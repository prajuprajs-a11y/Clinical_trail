{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "clinicaltrail123"
		},
		"Linked_service_Adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Linked_service_Adls'"
		},
		"Linked_serv_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1030-134951-7pn5yxsr"
		},
		"Linked_service_Adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsclinical.dfs.core.windows.net/"
		},
		"Linked_service_Azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "clinicaltraildatabase.database.windows.net"
		},
		"Linked_service_Azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Clnical_trail"
		},
		"Linked_service_Azuresql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "prajwalprajs"
		},
		"Linked_service_Keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://ClinicaltrialKeyvalult.vault.azure.net/"
		},
		"Linked_service_postgre_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-gentle-bonus-a1ve4ci5-pooler.ap-southeast-1.aws.neon.tech"
		},
		"Linked_service_postgre_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"Linked_service_postgre_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "clinicaltrail123_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Linked_service_Adls_accountKey": {
						"value": "[parameters('Linked_service_Adls_accountKey')]"
					},
					"Linked_service_Adls_properties_typeProperties_url": {
						"value": "[parameters('Linked_service_Adls_properties_typeProperties_url')]"
					},
					"Linked_service_Keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('Linked_service_Keyvault_properties_typeProperties_baseUrl')]"
					},
					"Linked_serv_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('Linked_serv_databricks_properties_typeProperties_existingClusterId')]"
					},
					"Linked_service_Azuresql_properties_typeProperties_server": {
						"value": "[parameters('Linked_service_Azuresql_properties_typeProperties_server')]"
					},
					"Linked_service_Azuresql_properties_typeProperties_database": {
						"value": "[parameters('Linked_service_Azuresql_properties_typeProperties_database')]"
					},
					"Linked_service_Azuresql_properties_typeProperties_userName": {
						"value": "[parameters('Linked_service_Azuresql_properties_typeProperties_userName')]"
					},
					"Linked_service_postgre_properties_typeProperties_server": {
						"value": "[parameters('Linked_service_postgre_properties_typeProperties_server')]"
					},
					"Linked_service_postgre_properties_typeProperties_database": {
						"value": "[parameters('Linked_service_postgre_properties_typeProperties_database')]"
					},
					"Linked_service_postgre_properties_typeProperties_username": {
						"value": "[parameters('Linked_service_postgre_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}